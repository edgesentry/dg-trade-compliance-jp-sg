# LiteLLM model id — swap freely among Gemini / OpenAI / Anthropic
# Default: Gemini 3.8 Flash
DG_EXTRACT_MODEL=gemini/gemini-3.8-flash

# Examples:
#   gemini/gemini-3.8-flash
#   openai/gpt-4o
#   anthropic/claude-sonnet-4-20250514

# Provider API keys (set only those you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=   # alias accepted by some Gemini setups

# LiteLLM proxy (./scripts/start_litellm.sh)
# LITELLM_HOST=0.0.0.0
# LITELLM_PORT=4000
# LITELLM_CONFIG=./litellm_config.yaml
# Point extract / OpenAI SDK at the local proxy:
# LITELLM_API_BASE=http://127.0.0.1:4000
# LITELLM_MASTER_KEY=sk-dg-local

# Optional: Azure / custom base
# AZURE_API_KEY=
# AZURE_API_BASE=
